{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); ['package-lock.json','yarn.lock'].forEach((f)=>{try{fs.rmSync(f,{force:true});}catch{}});\"",
    "postinstall": "npm --prefix artifacts/jigjiga-portal install",
    "dev": "node dev-server.mjs",
    "start": "node server.js",
    "build": "npm --prefix artifacts/jigjiga-portal run build",
    "build-portal": "npm --prefix artifacts/jigjiga-portal run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
